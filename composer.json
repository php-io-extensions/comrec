{
    "name": "php-io-extensions/comrec",
    "type": "php-ext",
    "description": "A frame of drawing commands in C: PixelQueue records shapes under a transform and a clip, keeps the last frame, and answers which pixels changed between the two",
    "keywords": [
        "queue",
        "2d",
        "display-list",
        "damage",
        "php-ext"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Project Saturn Studios, LLC",
            "email": "info@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": ">=8.4"
    },
    "require-dev": {
        "pestphp/pest": "^4.0"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.11.x-dev"
        }
    },
    "php-ext": {
        "extension-name": "comrec",
        "priority": 30,
        "support-zts": true,
        "support-nts": true,
        "os-families": [
            "linux",
            "darwin"
        ],
        "configure-options": [
            {
                "name": "enable-comrec",
                "description": "Enable the comrec extension",
                "needs-value": false
            }
        ]
    }
}
